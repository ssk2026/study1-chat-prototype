# Vercel server-side environment variables. Never put these values in dist/*.html.
OPENAI_API_KEY=
OPENAI_MODEL=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the current Supabase secret key. A legacy service_role key also works.
SUPABASE_SECRET_KEY=

# Optional metadata recorded with sessions.
STUDY_VERSION=pilot-001

